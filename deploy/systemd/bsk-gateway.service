# The browser client's server (client-rs/gateway), behind Caddy (https). Restarting it
# disconnects players in the browser, and desktop clients that play over https (wss).
# BSK_GATEWAY_FLAGS: --forward-address when the deploy config has "forward_address": true.
[Unit]
Description=betterSkillys gateway (browser play)
After=network.target bsk-account.service

[Service]
User=bsk
Group=bsk
EnvironmentFile=/opt/bsk/bsk.env
ExecStart=/opt/bsk/bin/bsk-gateway --web /opt/bsk/web --account http://127.0.0.1:${BSK_ACCOUNT_PORT} --allow ${BSK_PUBLIC_ADDRESS}:${BSK_WORLD_PORT}=127.0.0.1:${BSK_WORLD_PORT} --allow 127.0.0.1:${BSK_WORLD_PORT} --bind 127.0.0.1:${BSK_GATEWAY_PORT} $BSK_GATEWAY_FLAGS
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
